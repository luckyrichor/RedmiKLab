<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug-only ADB hook. android.permission.DUMP prevents ordinary apps from invoking it. -->
        <receiver
            android:name=".ScreenWakeDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.redmiklab.app.debug.SCREEN_WAKE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
